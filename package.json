{
  "name": "algorithm-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive visualizer for sorting, searching, data structures, graph algorithms, and dynamic programming, built with React and C++.",
  "keywords": [
    "algorithms",
    "visualization",
    "react",
    "typescript",
    "cpp",
    "drogon",
    "data-structures"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Kritika-kr/sorting-visualizer.git"
  },
  "scripts": {
    "start": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix frontend run test",
    "backend:configure": "cmake -S backend -B backend/build -DCMAKE_TOOLCHAIN_FILE=C:/Users/Kritika/vcpkg/scripts/buildsystems/vcpkg.cmake",
    "backend:build": "cmake --build backend/build"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.5.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20"
  },
  "dependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "framer-motion": "^12.0.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
